// RxTrack 2026-2s — modelo de datos.
// Ver ../../CLAUDE.md y la propuesta de arquitectura (secciones 3, 8, 9, 10).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estado de dominio de un módulo. MANUAL: lo pone la persona, no se deriva.
enum ModuleStatus {
  NO_VISTO
  EN_PROGRESO
  DOMINADO
}

/// Estado del informe de la práctica de laboratorio de un módulo.
enum LabReportStatus {
  PENDIENTE
  ENTREGADO
  CALIFICADO
}

/// Estado de un proyecto (entregable) de la asignatura.
enum ProjectStatus {
  POR_INICIAR
  EN_CURSO
  COMPLETADO
}

/// Origen de una tarjeta de repaso.
enum FlashcardSource {
  GLOSARIO
  FORMULA
  MANUAL
}

/// Asignatura — entidad raíz. id = slug ("aif", "ft2"). code = "AIF".
/// Los campos de contenido se resincronizan desde content/<code>.ts; el avance
/// (attendanceMissed, weeklyGoal, y todo lo que cuelga con fromContent=false) no.
model Subject {
  id                 String   @id
  code               String   @unique
  name               String
  credits            String?
  professors         String[]
  scheduleTheory     String?
  scheduleLab        String?
  descriptionSummary String?  @db.Text
  objectiveGeneral   String?  @db.Text
  objectivesSpecific String[]
  hasLab             Boolean  @default(false)
  totalClasses       Int      @default(32)
  /// Secciones visibles en la sub-nav (según la naturaleza de la asignatura).
  /// Vacío = todas. Se resincroniza desde content/<code>.ts.
  sections           String[] @default([])
  attendanceMissed   Int      @default(0)
  weeklyGoal         String?  @db.Text
  driveUrl           String?
  order              Int      @unique
  syncedAt           DateTime?
  /// Se refresca en cualquier escritura hija -> "hace N días sin tocar esto".
  lastActivityAt     DateTime?

  modules       Module[]
  projects      Project[]
  glossary      GlossaryTerm[]
  formulas      Formula[]
  keyDates      KeyDate[]
  evaluation    EvaluationItem[]
  bibliography  BibliographyItem[]
  pastMaterials PastMaterial[]
  flashcards    Flashcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tema del curso. slug estable dentro de la asignatura, viene de content/<code>.ts.
model Module {
  id              String          @id @default(cuid())
  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  description     String          @db.Text
  hasLab          Boolean         @default(false)
  status          ModuleStatus    @default(NO_VISTO)
  order           Int
  driveUrl        String?
  notesUrl        String?
  labProtocol     String?         @db.Text
  labReportStatus LabReportStatus?
  /// false = creado dentro de la app; el resync del seed lo ignora.
  fromContent     Boolean         @default(true)

  sessions       Session[]
  checklistItems ChecklistItem[]
  resources      Resource[]
  labMaterials   LabMaterial[]
  exercises      Exercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
}

/// Ejercicio resuelto de un módulo: enunciado + solución paso a paso, ambos en
/// Markdown (se renderizan con markdown-lite). Fuente de verdad en
/// content/<code>.ts; el seed lo empareja por (moduleId, question) y solo toca
/// filas fromContent=true. No guarda avance por ejercicio.
model Exercise {
  id          String  @id @default(cuid())
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question    String  @db.Text
  solution    String  @db.Text
  order       Int     @default(0)
  /// false = creado dentro de la app; el resync del seed lo ignora.
  fromContent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

/// Sesión de clase = apuntes en formato Cornell + transcripción, todo en Markdown.
/// Las diapositivas NO se guardan: se enlazan a Drive (slidesUrl).
model Session {
  id         String    @id @default(cuid())
  moduleId   String
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  number     Int?
  /// Fecha de la clase (no la de guardado).
  date       DateTime?
  topic      String
  content    String    @db.Text
  /// Transcripción de la clase, en Markdown. Alimenta el prompt de apuntes.
  transcript String?   @db.Text
  /// Enlace a las diapositivas de la clase (carpeta o archivo de Drive).
  slidesUrl  String?
  /// Snapshot de quién del grupo la subió.
  author     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

/// Subtarea. Cuelga de un Module (entregables del temario) O de un Project
/// (exactamente uno de moduleId / projectId). done y order viven aquí y nunca
/// se resincronizan.
model ChecklistItem {
  id        String   @id @default(cuid())
  moduleId  String?
  module    Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  done      Boolean  @default(false)
  order     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([projectId])
}

/// Enlace externo asociado a un módulo (video, artículo, guía).
model Resource {
  id       String  @id @default(cuid())
  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name     String
  url      String
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([moduleId])
}

/// Material / insumo de la práctica de laboratorio de un módulo.
model LabMaterial {
  id       String @id @default(cuid())
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean @default(false)
  order    Int     @default(0)

  @@index([moduleId])
}

/// Proyecto de la asignatura: entregable, informe, parcial a preparar, producto
/// final. El concepto de "ET en Marcha", ahora con subjectId. Casi siempre isManual.
model Project {
  id        String        @id @default(cuid())
  subjectId String
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  category  String?
  status    ProjectStatus @default(POR_INICIAR)
  driveUrl  String?
  order     Int
  /// false = sembrado desde content/<code>.ts (arreglo `projects`).
  isManual  Boolean       @default(true)

  checklistItems ChecklistItem[]
  notes          ProjectNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

/// Entrada de bitácora de un proyecto — lo que alimenta "Últimas actualizaciones".
/// Guarda snapshot de autor y rol para que la nota histórica no cambie después.
model ProjectNote {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  author     String
  authorRole String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

/// subjectId siempre; moduleId opcional (cross-link blando, como en el borrador).
model GlossaryTerm {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleId    String?
  term        String
  definition  String  @db.Text
  fromContent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

/// Fórmula con markup propio: _{sub}, ^{sup}, #{numerador|denominador}, \n.
model Formula {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleId    String?
  name        String
  expression  String   @db.Text
  variables   String   @db.Text @default("")
  description String   @db.Text @default("")
  derivation  String   @db.Text @default("")
  /// Ejemplos resueltos (Markdown, uno por elemento). Se renderizan aparte del
  /// desarrollo, en un bloque "Ejemplos resueltos".
  examples    String[] @default([])
  /// Orden de aparición en la pestaña Fórmulas (menor = primero). Lo fija el
  /// seed por la posición en content/<code>.ts; los agregados en la app van al final.
  order       Int      @default(0)
  fromContent Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

/// Parcial / entrega. El nombre y el peso vienen del temario; la fecha la pone
/// la persona y el seed nunca la toca.
model KeyDate {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime?
  weight      String?
  note        String?   @db.Text
  fromContent Boolean   @default(true)
  /// Módulos (ids) que cubre este parcial — para el "modo preparar parcial".
  moduleIds   String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

/// Sistema de evaluación (los pesos suman 100). grade opcional -> proyección de nota.
model EvaluationItem {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  weight    Int
  grade     Float?
  order     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

model BibliographyItem {
  id          String  @id @default(cuid())
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleId    String?
  kind        String  @default("libro")
  reference   String  @db.Text
  url         String?
  fromContent Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([subjectId])
}

/// Insumos: talleres/simulacros de semestres previos. `patterns` = el campo clave.
model PastMaterial {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleId  String?
  kind      String  @default("taller")
  title     String
  semester  String  @default("")
  url       String?
  patterns  String  @db.Text @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
}

/// Estado global del semestre (fila única, id = "singleton").
/// Incluye lo que sostiene el diseño para TDAH.
model SemesterMeta {
  id                String    @id @default("singleton")
  streakDays        Int       @default(0)
  streakLastDate    DateTime?
  /// Racha indulgente: fecha en la que ya se usó el día de gracia.
  streakGraceUsedOn DateTime?
  globalGoal        String?   @db.Text
  theme             String    @default("auto")

  /// "Continuar donde ibas" — un solo punto de retorno activo.
  resumeRoute String?
  resumeLabel String?
  resumeNote  String?
  resumeAt    DateTime?

  /// Ajustes de enfoque (tunables por la persona).
  focusItemCount Int     @default(3)
  showStreak     Boolean @default(true)
  gentleMotion   Boolean @default(true)
  dailyReminder  Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Bandeja de captura rápida: descargas una idea sin decidir dónde va; se
/// clasifica después hacia una asignatura.
model InboxItem {
  id        String    @id @default(cuid())
  text      String    @db.Text
  url       String?
  subjectId String?
  triagedAt DateTime?

  createdAt DateTime @default(now())

  @@index([triagedAt])
}

/// Tarjeta de repaso con repetición espaciada (SM-2). Se puede generar
/// automáticamente desde el glosario y las fórmulas, o crear a mano.
/// front/back en Markdown.
model Flashcard {
  id             String          @id @default(cuid())
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleId       String?
  front          String          @db.Text
  back           String          @db.Text
  source         FlashcardSource @default(MANUAL)
  /// id del GlossaryTerm / Formula de origen (para no duplicar al regenerar).
  sourceId       String?
  suspended      Boolean         @default(false)

  // --- Estado SM-2 ---
  dueDate        DateTime  @default(now())
  intervalDays   Int       @default(0)
  easeFactor     Float     @default(2.5)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceId])
  @@index([subjectId])
  @@index([dueDate])
}

/// Evento personal del calendario, no atado a un parcial (entrega, tutoría,
/// recordatorio). subjectId opcional para colorearlo por asignatura.
model PersonalEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  note      String?  @db.Text
  subjectId String?

  createdAt DateTime @default(now())

  @@index([date])
}

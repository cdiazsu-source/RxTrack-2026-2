# Copia este archivo a .env y completa los valores reales.

# --- Base de datos (PostgreSQL en Neon) ---
# En Neon: Dashboard del proyecto -> Connection string (la que incluye "?sslmode=require").
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/rxtrack?sslmode=require"

# --- Acceso al sitio (login compartido, dos perfiles, mismo usuario) ---
#   SITE_PASSWORD      -> perfil "full": edita todo          (default "RX2026")
#   SITE_PASSWORD_READ -> perfil "read": ve todo, no edita   (default "LEER")
# En Vercel: Project -> Settings -> Environment Variables. Usa valores propios.
# AUTH_SECRET firma la cookie de sesión: cualquier cadena larga y aleatoria.
SITE_USER="quimica"
SITE_PASSWORD="RX2026"
SITE_PASSWORD_READ="LEER"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
